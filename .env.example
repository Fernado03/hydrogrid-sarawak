# HydroGrid Sarawak environment template
# Copy this to .env for local development, but never commit real secrets.

HYDROGRID_ENV=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hydrogrid_warehouse
POSTGRES_USER=hydrogrid
POSTGRES_PASSWORD=change_me

OPEN_METEO_BASE_URL=https://api.open-meteo.com

LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_API_KEY=